<?xml version="1.0"?>
<!--
  DAVID dual-arm description.
  - Body (MiR250, frame, mounts, Schunk grippers, RealSense cameras): Onshape CAD export.
  - Arms: Universal Robots' own ur_robot macro (correct joint zeros, axis directions,
    masses, collision meshes, limits and standard frames: left_base, left_tool0, ...).
  - Driver: one ur_ros2_control block per arm -> two hardware interfaces, one controller_manager.

  Frames you will use:
    world -> root (MiR) -> left_mount  -> left_base_link  ... left_tool0  -> gripper
                        -> right_mount -> right_base_link ... right_tool0 -> gripper
    Use left_base / right_base (not *_base_link) for DH/IK: base_link is rotated 180 deg about Z.
-->
<robot name="david_dual" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />
    <xacro:include filename="$(find ur_robot_driver)/urdf/ur.ros2_control.xacro" />

    <!-- ======================= Arguments ======================= -->
    <xacro:arg name="left_ur_type"  default="ur5e" />
    <xacro:arg name="right_ur_type" default="ur5e" />
    <xacro:arg name="left_robot_ip"  default="192.168.56.101" />
    <xacro:arg name="right_robot_ip" default="192.168.56.102" />
    <xacro:arg name="left_kinematics_parameters_file"
               default="$(find ur_description)/config/$(arg left_ur_type)/default_kinematics.yaml" />
    <xacro:arg name="right_kinematics_parameters_file"
               default="$(find ur_description)/config/$(arg right_ur_type)/default_kinematics.yaml" />
    <!-- Where the Onshape body meshes live. ROS: inside david_launch. Isaac: pass a file:// path. -->
    <xacro:arg name="body_mesh_path" default="package://david_launch/meshes" />
    <xacro:arg name="use_mock_hardware" default="false" />
    <!-- Per-arm override, e.g. only the right robot connected: left_use_mock_hardware:=true -->
    <xacro:arg name="left_use_mock_hardware"  default="$(arg use_mock_hardware)" />
    <xacro:arg name="right_use_mock_hardware" default="$(arg use_mock_hardware)" />
    <xacro:arg name="headless_mode"     default="false" />

    <!-- Ports the robots connect back to on this PC (must not overlap) -->
    <xacro:arg name="left_reverse_port"         default="50001" />
    <xacro:arg name="left_script_sender_port"   default="50002" />
    <xacro:arg name="left_trajectory_port"      default="50003" />
    <xacro:arg name="left_script_command_port"  default="50004" />
    <xacro:arg name="right_reverse_port"        default="50005" />
    <xacro:arg name="right_script_sender_port"  default="50006" />
    <xacro:arg name="right_trajectory_port"     default="50007" />
    <xacro:arg name="right_script_command_port" default="50008" />

    <!-- MEASURE ON THE REAL ROBOT (radians). Rotation of each arm base about its own axis.
         Jog shoulder_pan to 0 on the pendant and turn this until RViz/Isaac matches. -->
    <xacro:arg name="left_base_yaw"  default="0.0" />
    <xacro:arg name="right_base_yaw" default="3.14159" />
    <!-- MEASURE: rotation of each gripper about the tool flange axis (radians).
         Put wrist_3 at 0 and turn this until the fingers match the real gripper. -->
    <xacro:arg name="left_gripper_yaw"  default="0.0" />
    <xacro:arg name="right_gripper_yaw" default="0.0" />

    <!-- ======================= World ======================= -->
    <link name="world" />
    <joint name="world_to_root" type="fixed">
        <parent link="world" />
        <child link="root" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- ======================= Body (from Onshape) ======================= -->
