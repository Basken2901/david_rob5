            <parent link="mask_lens_awg_rgb_1" />
            <child link="adhesive_lens_awg_rgb" />
        </joint>
        <joint name="group_2_fastened_joint_7" type="fixed">
            <origin xyz="-2.22045e-16 -2.22045e-16 2.77556e-17" rpy="-1.38778e-17 -1.38778e-17 -5.55112e-17" />
            <axis xyz="0 0 1" />
            <parent link="heatsink_awg_w_rgb" />
            <child link="front_cover_aluminum_awg_w_rgb_1" />
        </joint>
        <joint name="group_2_fastened_joint_8" type="fixed">
            <origin xyz="-0.0003 -1.11022e-16 0.02505" rpy="-1.38778e-17 -1.38778e-17 -5.55112e-17" />
            <axis xyz="0 0 1" />
            <parent link="rear_cover_aluminum_awg_rgb" />
            <child link="awg_asic_flex_1" />
        </joint>
        <joint name="group_2_fastened_joint_9" type="fixed">
            <origin xyz="-2.22045e-16 -2.22045e-16 2.77556e-17" rpy="-1.38778e-17 -1.38778e-17 -5.55112e-17" />
            <axis xyz="-0 -0 -1" />
            <parent link="lens_cover_awg_rgb_1" />
            <child link="paste_thermal_ir_awg_w_rgb_1" />
        </joint>
        <joint name="hanging_node_to_root_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 -0 0" />
            <axis xyz="0 0 1" />
            <parent link="root" />
            <child link="mir_250__1_" />
        </joint>
        <joint name="mate_connector_1" type="fixed">
            <origin xyz="0.000323635 -0.005 5.55112e-16" rpy="1.5708 -2.08167e-17 2.08167e-17" />
            <axis xyz="0 0 1" />
            <parent link="part_1" />
            <child link="mate_connector_1" />
        </joint>
        <joint name="mate_connector_1__1_" type="fixed">
            <origin xyz="0.000323635 -0.005 4.44089e-16" rpy="1.5708 -1.04083e-17 -1.04083e-17" />
            <axis xyz="0 0 1" />
            <parent link="part_1_1" />
            <child link="mate_connector_1__1_" />
        </joint>
        <joint name="mate_connector_2" type="fixed">
            <origin xyz="0 0 -1.11022e-16" rpy="-1.5708 -3.46945e-17 -3.46945e-17" />
            <axis xyz="0 0 1" />
            <parent link="part_1" />
            <child link="mate_connector_2" />
        </joint>
        <joint name="mate_connector_2__1_" type="fixed">
            <origin xyz="0 1.9082e-17 0" rpy="-1.5708 1.04083e-17 -1.04083e-17" />
            <axis xyz="0 0 1" />
            <parent link="part_1_1" />
            <child link="mate_connector_2__1_" />
        </joint>
        <joint name="mate_connector_3" type="fixed">
            <origin xyz="-2.22045e-16 -1.11022e-16 -2.77556e-17" rpy="3.14159 -1.38778e-17 -5.55112e-17" />
            <axis xyz="0 0 1" />
            <parent link="rear_cover_aluminum_awg_rgb" />
            <child link="mate_connector_3" />
        </joint>
        <joint name="mate_connector_3__1_" type="fixed">
            <origin xyz="1.11022e-16 -1.11022e-16 4.33681e-18" rpy="-3.14159 -0 0" />
            <axis xyz="0 0 1" />
            <parent link="rear_cover_aluminum_awg_rgb_1" />
            <child link="mate_connector_3__1_" />
        </joint>
        <joint name="mate_connector_4" type="fixed">
            <origin xyz="0.000161818 -0.005 0.0580488" rpy="1.5708 -2.08167e-17 2.08167e-17" />
            <axis xyz="0 0 1" />
            <parent link="part_1" />
            <child link="mate_connector_4" />
        </joint>
        <joint name="mate_connector_4__1_" type="fixed">
            <origin xyz="0.000161818 -0.005 0.0580488" rpy="1.5708 -1.04083e-17 -1.04083e-17" />
            <axis xyz="0 0 1" />
            <parent link="part_1_1" />
            <child link="mate_connector_4__1_" />
        </joint>

    <!-- ======================= Arm mounts =======================
         Measured from the CAD: UR base mounting surface, base axis tilted 45 deg outward.
         (Cross-checked against UR5e d1 = 0.1625 m: matches within ~1.5 mm.) -->
    <link name="left_mount" />
    <joint name="root_to_left_mount" type="fixed">
        <parent link="root" />
        <child link="left_mount" />
        <origin xyz="0.0006 0.2112 0.4902" rpy="-0.785398 0 0" />
    </joint>

    <link name="right_mount" />
    <joint name="root_to_right_mount" type="fixed">
        <parent link="root" />
        <child link="right_mount" />
        <origin xyz="0.0006 -0.2139 0.4902" rpy="0.785398 0 0" />
    </joint>

    <!-- ======================= Arms (UR macro) ======================= -->
    <xacro:ur_robot
        name="left"
        tf_prefix="left_"
        parent="left_mount"
        joint_limits_parameters_file="$(find ur_description)/config/$(arg left_ur_type)/joint_limits.yaml"
        kinematics_parameters_file="$(arg left_kinematics_parameters_file)"
        physical_parameters_file="$(find ur_description)/config/$(arg left_ur_type)/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/$(arg left_ur_type)/visual_parameters.yaml">
        <origin xyz="0 0 0" rpy="0 0 $(arg left_base_yaw)" />
    </xacro:ur_robot>

    <xacro:ur_robot
        name="right"
        tf_prefix="right_"
        parent="right_mount"
        joint_limits_parameters_file="$(find ur_description)/config/$(arg right_ur_type)/joint_limits.yaml"
        kinematics_parameters_file="$(arg right_kinematics_parameters_file)"
        physical_parameters_file="$(find ur_description)/config/$(arg right_ur_type)/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/$(arg right_ur_type)/visual_parameters.yaml">
        <origin xyz="0 0 0" rpy="0 0 $(arg right_base_yaw)" />
    </xacro:ur_robot>

    <!-- ======================= Grippers on the tool flanges =======================
         part_1 (adapter plate) origin sits exactly on the UR flange in the CAD;
         its +Y points into the robot, hence roll -90 deg. -->
    <joint name="left_tool0_to_gripper" type="fixed">
        <parent link="left_tool0" />
        <child link="part_1" />
        <origin xyz="0 0 0" rpy="-1.570796 0 $(arg left_gripper_yaw)" />
    </joint>
    <joint name="right_tool0_to_gripper" type="fixed">
        <parent link="right_tool0" />
        <child link="part_1_1" />
        <origin xyz="0 0 0" rpy="-1.570796 0 $(arg right_gripper_yaw)" />
    </joint>

    <!-- ======================= Driver: one hardware interface per arm ======================= -->
    <xacro:ur_ros2_control
        name="left"
        tf_prefix="left_"
        ur_type="$(arg left_ur_type)"
        kinematics_parameters_file="$(arg left_kinematics_parameters_file)"
        robot_ip="$(arg left_robot_ip)"
        script_filename="$(find ur_client_library)/resources/external_control.urscript"
        output_recipe_filename="$(find ur_robot_driver)/resources/rtde_output_recipe.txt"
        input_recipe_filename="$(find ur_robot_driver)/resources/rtde_input_recipe.txt"
        use_mock_hardware="$(arg left_use_mock_hardware)"
        mock_sensor_commands="false"
        headless_mode="$(arg headless_mode)"
        reverse_port="$(arg left_reverse_port)"
        script_sender_port="$(arg left_script_sender_port)"
        trajectory_port="$(arg left_trajectory_port)"
        script_command_port="$(arg left_script_command_port)"
    />

    <xacro:ur_ros2_control
        name="right"
        tf_prefix="right_"
        ur_type="$(arg right_ur_type)"
        kinematics_parameters_file="$(arg right_kinematics_parameters_file)"
        robot_ip="$(arg right_robot_ip)"
        script_filename="$(find ur_client_library)/resources/external_control.urscript"
        output_recipe_filename="$(find ur_robot_driver)/resources/rtde_output_recipe.txt"
        input_recipe_filename="$(find ur_robot_driver)/resources/rtde_input_recipe.txt"
        use_mock_hardware="$(arg right_use_mock_hardware)"
        mock_sensor_commands="false"
        headless_mode="$(arg headless_mode)"
        reverse_port="$(arg right_reverse_port)"
        script_sender_port="$(arg right_script_sender_port)"
        trajectory_port="$(arg right_trajectory_port)"
        script_command_port="$(arg right_script_command_port)"
    />

</robot>
