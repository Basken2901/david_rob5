# Install on DAVID onboard PC as ~/.config/david/cameras.env
# Determine serial numbers with rs-enumerate-devices.
DAVID_LEFT_SERIAL=
DAVID_RIGHT_SERIAL=

# Match onboard camera DDS to the real-robot/Isaac communication graph.
# The existing real-robot Docker Compose currently sets ROS_DOMAIN_ID=1.
ROS_DOMAIN_ID=1
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# ROS_STATIC_PEERS=192.168.0.200
